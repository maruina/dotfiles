#!/bin/bash
set -eufo pipefail

# Register pi native MCP servers (pi >= 0.99.2) in ~/.pi/agent/mcp.json.
# pi mcp add is add-or-replace and preserves unrelated entries, such as the
# IT-managed trajectory server. Remove legacy Datadog entries from both
# profiles during the auth migration; preserve unrelated entries.
{{ if eq .profile "work" }}
pi mcp remove ha-mcp >/dev/null 2>&1 || true
pi mcp remove b2-mcp >/dev/null 2>&1 || true
pi mcp remove datadog-prod >/dev/null 2>&1 || true
pi mcp remove datadog-staging >/dev/null 2>&1 || true

pi mcp add agentic-review \
  --url "https://agentic-review-mcp.mcp.us1.ddbuild.io/internal/mcp" \
  --exposure deferred \
  --description 'Query Agentic Review Platform (ARP) PR review status and findings. Request reviews and record permanent finding resolutions only on explicit request; writes affect production. Sign in once with: pi mcp login agentic-review.'

pi mcp add ddci-mcp-prod --url "https://ddci-mcp.mcp.us1.ddbuild.io/internal/mcp" \
  --exposure deferred \
  --description 'Query and control DDCI (GitLab CI) pipelines: status, AI error summaries, job logs, retry failed jobs, trigger auto/on-demand runs, local build impact analysis. Sign in once with: pi mcp login ddci-mcp-prod.'

pi mcp add datadog-google-workspace \
  --url "https://google-workspace-mcp-server-834963730936.us-central1.run.app/mcp" \
  --exposure deferred \
  --description 'Search and read Google Drive, Docs, Sheets, and Slides with your Datadog Google account. Write only on explicit request. Sign in once with: pi mcp login datadog-google-workspace.'

pi mcp add slack \
  --exposure deferred \
  --description 'Search and read Datadog Slack channels, threads, and users. Send only on explicit request.' \
  -- python3 '~/.pi/agent/skills_work/slack-mcp/scripts/slack-mcp-proxy.py'
{{ else }}
pi mcp remove agentic-review >/dev/null 2>&1 || true
pi mcp remove datadog-prod >/dev/null 2>&1 || true
pi mcp remove datadog-staging >/dev/null 2>&1 || true
pi mcp remove ddci-mcp-prod >/dev/null 2>&1 || true
pi mcp remove datadog-google-workspace >/dev/null 2>&1 || true
pi mcp remove slack >/dev/null 2>&1 || true

# The connect URL is the only Home Assistant credential; resolve it from
# 1Password at apply time so it never lives in fish env or chezmoi source.
ha_url="$(op read 'op://Private/Home Assistant/mcp_url')"

pi mcp add ha-mcp \
  --url "$ha_url" \
  --exposure deferred \
  --description 'Home Assistant inventory, state, history, and confirmed control. Routed by the home-assistant skill tiers.'

# Both B2 credential fields resolve from 1Password at apply time so the key
# never lives in fish env or chezmoi source.
b2_key_id="$(op read 'op://Private/Backblaze/mcp-key-id')"
b2_key="$(op read 'op://Private/Backblaze/mcp-application-key')"

# deliberate: pinned to installed asdf node 24.20.0 because @backblaze-labs/b2-mcp
# declares engines ^22.22.2 || ^24 || ^26 and the default global node is 25.2.1.
# Upgrade path: change the pin when asdf's default moves to 24.x/26.x.
pi mcp add b2-mcp \
  --env "B2_APPLICATION_KEY_ID=$b2_key_id" \
  --env "B2_APPLICATION_KEY=$b2_key" \
  --exposure deferred \
  --description 'Query and manage Backblaze B2 buckets, files, the S3 data plane, and application keys. Read-only by default; write and destructive tools gated, use only on explicit request.' \
  -- "$HOME/.asdf/installs/nodejs/24.20.0/bin/npx" -y @backblaze-labs/b2-mcp
{{ end }}

# mcp.json can contain the Home Assistant connect URL; keep it user-readable only.
chmod 600 "$HOME/.pi/agent/mcp.json"
