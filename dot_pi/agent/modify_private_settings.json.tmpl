#!/bin/sh
# Chezmoi owns stable pi settings only. Pi owns runtime fields such as
# lastChangelogVersion, defaultProvider, defaultModel, and defaultThinkingLevel.
set -eu

input=$(cat)
if [ -z "$input" ]; then
  input='{}'
fi

printf '%s\n' "$input" | jq '
{{- if eq .profile "work" }}
  .skills = [
    "{{ .chezmoi.homeDir }}/.pi/agent/skills_work",
    "/Users/matteo.ruina/dd/claude-marketplace/compute/skills",
    "/Users/matteo.ruina/dd/claude-marketplace/compute-support/skills",
    "/Users/matteo.ruina/dd/claude-marketplace/dd/skills/conductor"
  ] |
  .packages = [
    "../../go/src/github.com/DataDog/datadog-pi-packages/packages/refresh-models",
    "../../go/src/github.com/DataDog/datadog-pi-packages/packages/confluence-adf",
    "../../go/src/github.com/DataDog/datadog-pi-packages/packages/pi-npm-guard",
    "../../go/src/github.com/DataDog/datadog-pi-packages/packages/prompt-stash",
    "../../go/src/github.com/DataDog/datadog-pi-packages/packages/session-cost"
  ] |
{{- end }}
{{- if eq .profile "personal" }}
  .skills = [
    "{{ .chezmoi.homeDir }}/.pi/agent/skills_personal"
  ] |
  .packages = [
    "../../go/src/github.com/DataDog/datadog-pi-packages/packages/pi-npm-guard",
    "../../go/src/github.com/DataDog/datadog-pi-packages/packages/prompt-stash"
  ] |
{{- end }}
  .npmCommand = [
    "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/pi-npm-guard/bin/pi-npm-guard.mjs"
  ] |
  .npmGuard = {
    "enabled": true,
    "middlewares": [
      {
        "path": "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/npm-guarddog-scan/middleware/guarddog.mjs"
      }
    ]
  } |
  del(.extensions.files) |
  .extensionSettings.files.diffEditor = "zed" |
  .extensionSettings.files.externalEditor = "zed" |
  .theme = "catppuccin-frappe" |
  .markdown.codeBlockIndent = ""
'
