{{- if eq .profile "work" -}}
{
  "providers": {
    "anthropic": {
      "headers": {
        "x-dd-tag-ml_app": "pi",
        "ml-app-id": "ai-devx.pi",
        "x-dd-tag-dd.user_email": "{{ .email }}",
        "x-dd-tag-dd.team": "compute",
        "x-dd-tag-client_session_id": "$PI_CLIENT_SESSION_ID",
        "anthropic-beta": "context-1m-2025-08-07"
      },
      "compat": {
        "supportsStrictTools": false,
        "supportsMidConvoSystemMessages": false,
        "supportsMidConvoToolChanges": false,
        "supportsMidConvoEffort": false
      }
    },
    {{/* deliberate: dd-ai-gateway replaces the openai model list. Keep these refresh-models 0.7.1 entries separate until Pi bundles GPT-6.2 Astra and Sol. */ -}}
    "openai-gpt-6-2": {
      "baseUrl": "https://ai-gateway.us1.ddbuild.io/v1",
      "apiKey": "!ddtool auth token rapid-ai-platform --datacenter us1.ddbuild.io",
      "authHeader": true,
      "headers": {
        "org-id": "2",
        "source": "pi",
        "ml-app-id": "ai-devx.pi",
        "claude-code": "true",
        "x-llmo-force-redaction": "true",
        "x-dd-tag-ml_app": "pi",
        "x-dd-tag-dd.user_email": "{{ .email }}",
        "x-dd-tag-dd.team": "compute",
        "x-dd-tag-client_session_id": "$PI_CLIENT_SESSION_ID"
      },
      "models": [
        {
          "id": "openai/gpt-6.2-astra",
          "name": "GPT-6.2 Astra",
          "api": "openai-responses",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 272000,
          "maxTokens": 128000,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "compat": {
            "supportsStrictMode": true,
            "supportsOpenAIGrammarTools": true,
            "supportsAdditionalTools": true,
            "supportsToolSearch": true,
            "supportsMidConvoSystemMessages": true,
            "supportsExplicitPromptCacheMode": true
          },
          "inputLimits": {
            "maxRequestBytes": 536870912,
            "images": {
              "maxPerRequest": 1500,
              "resize": {
                "maxWidth": 2000,
                "maxHeight": 2000,
                "maxBytes": 4718592,
                "jpegQuality": 80
              }
            }
          }
        },
        {
          "id": "openai/gpt-6.2-sol",
          "name": "GPT-6.2 Sol",
          "api": "openai-responses",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 272000,
          "maxTokens": 128000,
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": "xhigh",
            "max": "max"
          },
          "compat": {
            "supportsStrictMode": true,
            "supportsOpenAIGrammarTools": true,
            "supportsAdditionalTools": true,
            "supportsToolSearch": true,
            "supportsMidConvoSystemMessages": true,
            "supportsExplicitPromptCacheMode": true
          },
          "inputLimits": {
            "maxRequestBytes": 536870912,
            "images": {
              "maxPerRequest": 1500,
              "resize": {
                "maxWidth": 2000,
                "maxHeight": 2000,
                "maxBytes": 4718592,
                "jpegQuality": 80
              }
            }
          }
        }
      ]
    },
    "openai": {
      "headers": {
        "x-dd-tag-ml_app": "pi",
        "ml-app-id": "ai-devx.pi",
        "x-dd-tag-dd.user_email": "{{ .email }}",
        "x-dd-tag-dd.team": "compute",
        "x-dd-tag-client_session_id": "$PI_CLIENT_SESSION_ID"
      }
    },
    "google": {
      "headers": {
        "x-dd-tag-ml_app": "pi",
        "ml-app-id": "ai-devx.pi",
        "x-dd-tag-dd.user_email": "{{ .email }}",
        "x-dd-tag-dd.team": "compute",
        "x-dd-tag-client_session_id": "$PI_CLIENT_SESSION_ID"
      }
    },
    "baseten": {
      "headers": {
        "x-dd-tag-ml_app": "pi",
        "ml-app-id": "ai-devx.pi",
        "x-dd-tag-dd.user_email": "{{ .email }}",
        "x-dd-tag-dd.team": "compute",
        "x-dd-tag-client_session_id": "$PI_CLIENT_SESSION_ID"
      }
    },
    "typesafe": {
      "headers": {
        "source": "pi",
        "org-id": "2",
        "x-llmo-force-redaction": "true",
        "x-dd-tag-ml_app": "pi",
        "ml-app-id": "ai-devx.pi",
        "x-dd-tag-client_session_id": "$PI_CLIENT_SESSION_ID",
        "x-dd-tag-dd.user_email": "matteo.ruina@datadoghq.com",
        "x-dd-tag-dd.team": "compute",
        "provider": "typesafe"
      }
    }
  }
}
{{ end -}}
