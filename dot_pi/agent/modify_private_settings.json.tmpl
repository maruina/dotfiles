#!/bin/sh
# Chezmoi owns stable pi settings only. Pi owns runtime fields such as
# lastChangelogVersion, defaultProvider, defaultModel, defaultThinkingLevel, and enabledModels.
set -eu

input=$(cat)
if [ -z "$input" ]; then
  input='{}'
fi

printf '%s\n' "$input" | jq '
{{- if eq .profile "work" }}
  .skills = [
    "{{ .chezmoi.homeDir }}/.pi/agent/skills_work",
    "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/chonk-upload/skills/chonk-upload",
    "/Users/matteo.ruina/dd/claude-marketplace/compute/skills",
    "!/Users/matteo.ruina/dd/claude-marketplace/compute/skills/k8s-api-design",
    "!/Users/matteo.ruina/dd/claude-marketplace/compute/skills/k8s-controller-dev",
    "/Users/matteo.ruina/dd/claude-marketplace/compute-support/skills",
    "/Users/matteo.ruina/dd/claude-marketplace/dd/skills/conductor"
  ] |
  .packages = [
    "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/dd-ai-gateway",
    "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/confluence-cli",
    "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/pi-npm-guard",
    "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/prompt-stash",
    "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/session-cost",
    "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/research-web",
    "npm:@datadog/pi-plugin",
    "npm:@pi-minimal/mention-skills"
  ] |
  .npmCommand = [
    "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/pi-npm-guard/bin/pi-npm-guard.mjs"
  ] |
  .npmGuard = {
    "enabled": true,
    "middlewares": [
      {
        "path": "{{ .chezmoi.homeDir }}/go/src/github.com/DataDog/datadog-pi-packages/packages/npm-guarddog-scan/middleware/guarddog.mjs"
      }
    ]
  } |
{{- end }}
{{- if eq .profile "personal" }}
  .skills = [
    "{{ .chezmoi.homeDir }}/.pi/agent/skills_personal"
  ] |
  .packages = [
    "npm:@datadog/pi-plugin",
    "npm:@pi-minimal/mention-skills"
  ] |
  del(.npmCommand) |
  del(.npmGuard) |
{{- end }}
  .defaultTools = ["+codemode"] |
  del(.extensions.files) |
  .extensionSettings.files.diffEditor = "zed" |
  .extensionSettings.files.externalEditor = "zed" |
  .theme = "catppuccin-frappe" |
  .markdown.codeBlockIndent = ""
'
