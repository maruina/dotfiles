{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "exact_extensions/**/*.ts",
    "extensions/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
