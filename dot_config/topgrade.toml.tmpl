[misc]
# IT manages OS and Tailscale updates. Disable noisy, unused, or duplicate steps.
disable = [
  "system",
  "helm",
  "pnpm",
  "yarn",
  "bun_packages",
  "containers",
  "github_cli_skills",
  "gcloud",
{{- if eq .profile "work" }}
  "tailscale",
{{- end }}
]

# Run autonomously without interactive confirmations or retry prompts.
assume_yes = true
ask_retry = false
show_skipped = false

[git]
# Avoid fetching stale repos from Topgrade's predefined search paths.
pull_predefined = false
# Keep remote refs fresh without merging, rebasing, or changing checked-out files.
fetch_only = true

{{- if eq .profile "work" }}
repos = [
  "~/dd/*/",
]
{{- else }}
repos = []
{{- end }}

{{- if eq .profile "work" }}
[commands]
"Dogbrew" = "dogbrew update-all"
{{- end }}
